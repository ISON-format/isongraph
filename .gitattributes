# Normalize line endings across platforms
* text=auto

# Always LF for cross-platform tooling
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Conformance vectors are compared byte-for-byte by every port's test suite
vectors/** text eol=lf
